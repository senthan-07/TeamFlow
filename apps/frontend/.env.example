# Backend origin, no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional TURN server for video calls behind strict NATs / corporate firewalls
# (comma-separate multiple URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349)
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
