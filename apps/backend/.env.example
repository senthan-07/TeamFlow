# Required
DATABASE_URL=postgresql://user:password@host:5432/teamflow
JWT_SECRET=change-me-to-a-long-random-string

# Optional
PORT=4000
# Comma-separated list of allowed frontend origins, or * to allow any
CORS_ORIGIN=https://your-frontend.example.com
# Where uploaded files are stored (defaults to ./uploads)
UPLOAD_DIR=
MAX_UPLOAD_MB=25
